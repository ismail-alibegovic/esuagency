# ESU Agency — Apache settings for cPanel hosting
DirectoryIndex index.html
# Never list folder contents (written without "Options" so it cannot cause a 500 on strict hosts)
<IfModule mod_autoindex.c>
  IndexIgnore *
</IfModule>

# Uncomment after SSL (AutoSSL / Let's Encrypt) is active for the domain:
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Hashed build files never change: cache for a year
  <FilesMatch "^.+\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|ico|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml text/plain
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/javascript .js
</IfModule>
